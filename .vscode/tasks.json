{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP32: Compilar com ESP-IDF 5.5.5 (EIM)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Rodar.ps1",
                "-Etapa",
                "Compilar"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
